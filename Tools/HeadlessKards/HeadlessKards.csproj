<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefaultItemExcludes>$(DefaultItemExcludes);out/**;artifacts/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup><Content Update="cards.json" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup Condition="Exists('../HeadlessRngRust/target/release/headless_rng.dll')">
    <Content Include="../HeadlessRngRust/target/release/headless_rng.dll" Link="headless_rng.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../HeadlessCore/target/release/headless_core.dll')">
    <Content Include="../HeadlessCore/target/release/headless_core.dll" Link="headless_core.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
